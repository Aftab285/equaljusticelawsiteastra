      lead: 'Holding employers accountable for retaliating against workers who assert California statutory rights.',
      directAnswer: 'California law strictly prohibits employers from punishing workers who file harassment complaints, report safety violations, request disability accommodations, or demand correct wage payments.',
      statutes: 'California Labor Code § 1102.5; Gov. Code § 12940(h).',
      deadline: '3 Years under FEHA (Gov Code § 12960).',
      whoApplies: 'Workers who faced demotions, pay cuts, unfair write-ups, or hostile treatment after asserting rights.',
      commonSituations: ['Sudden disciplinary action following an HR complaint', 'Hostile shift assignments after requesting family leave', 'Blacklisting'],
      evidence: ['Written complaints, timeline of retaliatory events, and personnel records'],
      remedies: ['Lost wages, statutory penalties up to $10,000 per violation under Labor Code § 1102.5, and attorney fees'],
      mistakes: ['Failing to maintain a personal written chronology of retaliatory actions'],
      reviewer: 'Reviewed by Employment Practice Group'
    },
    {
      slug: 'whistleblower-retaliation',
      title: 'California Whistleblower Protection Lawyers',
      kicker: 'LABOR CODE § 1102.5 ADVOCACY',
      lead: 'Defending courageous employees who report legal violations, safety hazards, and corporate fraud.',
      directAnswer: 'California Labor Code § 1102.5 is one of the most powerful whistleblower shields in the country, protecting employees who disclose information to a government agency or supervisor regarding violations of state or federal statutes.',
      statutes: 'California Labor Code § 1102.5; California False Claims Act (Gov. Code § 12650 et seq.).',
      deadline: '3 Years from the retaliatory action.',
      whoApplies: 'Workers terminated, demoted, or harassed for refusing to participate in illegal conduct or reporting fraud.',
      commonSituations: ['Reporting environmental or safety violations', 'Refusing to falsify billing or accounting documents', 'Reporting patient safety concerns in healthcare'],
      evidence: ['Internal memos, compliance hotline reports, and termination records'],
      remedies: ['Full reinstatement or front pay, statutory civil penalties, and emotional distress damages'],
      mistakes: ['Taking proprietary employer files without attorney guidance on protected whistleblowing protocols'],
      reviewer: 'Reviewed by Whistleblower Litigation Team'
    }
  ];

  return practices.map(p => ({
    params: { slug: p.slug },
    props: { practice: p }
  }));
}

const { practice } = Astro.props;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Practice Areas', href: '/practice-areas' },
  { label: practice.title }
];
---

<Layout 
  title={`${practice.title} | Equal Justice Lawyers`}
  description={`Comprehensive California legal guide on ${practice.title}. Learn your statutory rights, deadlines, and how our trial attorneys fight for you.`}
>
  <Navbar transparent={false} />

  <main id="main-content">
    <PageHero 
      kicker={practice.kicker}
      title={practice.title}
      lead={practice.lead}
      breadcrumb={breadcrumbs}
    />

    <!-- Main Content Body -->
    <section class="section-light practice-detail-content">
      <div class="section-container detail-layout-grid">
        <!-- Left Main Content -->
        <div class="detail-main-column">
          <!-- The Short Answer / AEO Direct Answer -->
          <div class="aeo-answer-card">
            <div class="aeo-header">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#c8a04a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="16" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
              </svg>
              <span>The Direct Answer: California Legal Overview</span>
            </div>
            <p class="aeo-text">{practice.directAnswer}</p>
          </div>

          <!-- Section: Governing California Statutes -->
          <div class="content-block">
            <h2 class="content-heading">Governing California Statutes & Precedents</h2>
            <div class="statutes-highlight-box">
              <p><strong>Applicable Law:</strong> {practice.statutes}</p>
            </div>
          </div>

          <!-- Section: Strict California Deadlines -->
          <div class="content-block">
            <h2 class="content-heading">Statute of Limitations & Strict Deadlines</h2>
            <p class="deadline-warning-text">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#c8a04a" stroke-width="2">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                <line x1="12" y1="9" x2="12" y2="13"></line>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
              </svg>
              <span>{practice.deadline}</span>
            </p>
          </div>

          <!-- Section: Who This Applies To -->
          <div class="content-block">
            <h2 class="content-heading">Who This Applies To in California</h2>
            <p class="body-text">{practice.whoApplies}</p>
          </div>

          <!-- Section: Common Scenarios -->
          <div class="content-block">
            <h2 class="content-heading">Common Scenarios & Violations</h2>
            <ul class="bullet-list">
              {practice.commonSituations.map(s => (
                <li>
                  <span class="bullet-icon">✓</span>
                  <span>{s}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Section: Evidence That Matters -->
          <div class="content-block">
            <h2 class="content-heading">Critical Evidence in California Courts</h2>
            <ul class="bullet-list">
              {practice.evidence.map(e => (
                <li>
                  <span class="bullet-icon">✓</span>
                  <span>{e}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Section: Potential Remedies -->
          <div class="content-block">
            <h2 class="content-heading">Potential Legal Remedies & Financial Recovery</h2>
            <ul class="bullet-list">
              {practice.remedies.map(r => (
                <li>
                  <span class="bullet-icon">✓</span>
                  <span>{r}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Section: Mistakes to Avoid -->
          <div class="content-block">
            <h2 class="content-heading">Common Mistakes That Harm California Claims</h2>
            <ul class="bullet-list mistakes-list">
              {practice.mistakes.map(m => (
                <li>
                  <span class="bullet-icon alert">✕</span>
                  <span>{m}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Reviewer Box -->
          <div class="author-reviewer-box">
            <div class="reviewer-badge">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#c8a04a" stroke-width="2">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              <span>{practice.reviewer}</span>
            </div>
            <p class="reviewer-note">
              This guide provides general California legal educational information under State Bar ethics rules. It is not individualized legal advice. To evaluate your specific claim, request a confidential intake below.
            </p>
          </div>
        </div>

        <!-- Right Sidebar -->
        <aside class="detail-sidebar">
          <div class="sidebar-sticky-box">
            <div class="sidebar-card eval-card">
              <h3 class="sidebar-title">Have Questions About Your Situation?</h3>
              <p class="sidebar-desc">
                Speak with our California intake team. 100% confidential, free of charge, and no obligation.
              </p>
              <a href="#case-evaluation" class="btn-gold sidebar-cta">
                <span>Start Free Evaluation</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"></path>
                </svg>
              </a>
              <div class="sidebar-phone">
                <span>Confidential Intake Email:</span>
                <a href="mailto:legal@equaljusticelawyers.com">legal@equaljusticelawyers.com</a>
              </div>
            </div>

            <div class="sidebar-card nav-card">
              <h4 class="sidebar-nav-heading">Other Practice Areas</h4>
              <ul class="sidebar-links">
                <li><a href="/practice-areas/personal-injury">Personal Injury</a></li>
                <li><a href="/practice-areas/car-accidents">Car Accidents</a></li>
                <li><a href="/practice-areas/employment-law">Employment Law</a></li>
                <li><a href="/practice-areas/wrongful-termination">Wrongful Termination</a></li>
                <li><a href="/practice-areas/wage-and-hour">Wage & Hour Law</a></li>
                <li><a href="/practice-areas/disability-rights">Disability Rights & ADA</a></li>
                <li><a href="/practice-areas/medical-malpractice">Medical Malpractice</a></li>
                <li><a href="/practice-areas/consumer-protection">Consumer Protection</a></li>
              </ul>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <!-- Case Evaluation Form -->
    <CaseEvaluation />
  </main>

  <Footer />
  <StickyCTA />
  <CaseAssistant />
</Layout>

<style>
  .practice-detail-content {
    padding: 4.5rem 0;
    border-bottom: 1px solid rgba(200, 160, 74, 0.2);
  }

  .detail-layout-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 4rem;
  }

  .detail-main-column {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  /* AEO Direct Answer Card */
  .aeo-answer-card {
    background: var(--color-white);
    border: 1.5px solid var(--color-gold);
    border-radius: var(--radius-md);
    padding: 2rem;
    box-shadow: var(--shadow-card);
  }

  .aeo-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-gold-dark);
    margin-bottom: 0.8rem;
  }

  .aeo-text {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--color-dark-green);
    font-weight: 500;
  }

  .content-heading {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-dark-green);
    margin-bottom: 1rem;
    position: relative;
    padding-bottom: 0.4rem;
  }

  .content-heading::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 36px;
    height: 2px;
    background: var(--color-gold);
  }

  .body-text {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text-dark-muted);
  }

  .statutes-highlight-box {
    background: var(--color-bg-cream);
    border-left: 3px solid var(--color-gold);
    padding: 1rem 1.4rem;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-dark-green);
  }

  .deadline-warning-text {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    background: rgba(200, 160, 74, 0.1);
    border: 1px solid rgba(200, 160, 74, 0.3);
    padding: 1rem 1.25rem;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    color: var(--color-dark-green);
    line-height: 1.5;
  }

  .deadline-warning-text svg {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .bullet-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .bullet-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.92rem;
    color: var(--color-text-dark-muted);
    line-height: 1.55;
  }

  .bullet-icon {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: rgba(200, 160, 74, 0.15);
    color: var(--color-gold-dark);
    font-size: 0.75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .bullet-icon.alert {
    background: rgba(220, 38, 38, 0.12);
    color: #dc2626;
  }

  /* Author Reviewer Box */
  .author-reviewer-box {
    background: var(--color-white);
    border: 1px solid rgba(200, 160, 74, 0.25);
    border-radius: var(--radius-sm);
    padding: 1.4rem 1.6rem;
    margin-top: 1rem;
  }

  .reviewer-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-dark-green);
    margin-bottom: 0.4rem;
  }

  .reviewer-note {
    font-size: 0.78rem;
    color: var(--color-text-dark-muted);
    line-height: 1.5;
  }

  /* Sidebar */
  .sidebar-sticky-box {
    position: sticky;
    top: 90px;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .sidebar-card {
    background: var(--color-white);
    border: 1px solid rgba(200, 160, 74, 0.25);
    border-radius: var(--radius-md);
    padding: 1.8rem;
    box-shadow: var(--shadow-card);
  }

  .sidebar-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-dark-green);
    margin-bottom: 0.6rem;
  }

  .sidebar-desc {
    font-size: 0.84rem;
    color: var(--color-text-dark-muted);
    line-height: 1.55;
    margin-bottom: 1.5rem;
  }

  .sidebar-cta {
    width: 100%;
    justify-content: center;
    margin-bottom: 1.2rem;
  }

  .sidebar-phone {
    text-align: center;
    font-size: 0.78rem;
    color: var(--color-text-dark-muted);
    border-top: 1px solid rgba(200, 160, 74, 0.2);
    padding-top: 0.8rem;
  }

  .sidebar-phone a {
    display: block;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-dark-green);
    margin-top: 0.2rem;
    transition: color 0.2s;
  }

  .sidebar-phone a:hover {
    color: var(--color-gold);
  }

  .sidebar-nav-heading {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-dark-green);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(200, 160, 74, 0.2);
  }

  .sidebar-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .sidebar-links a {
    font-size: 0.84rem;
    color: var(--color-text-dark-muted);
    transition: color 0.2s, transform 0.2s;
    display: inline-block;
  }

  .sidebar-links a:hover {
    color: var(--color-gold-dark);
    transform: translateX(3px);
  }

  @media (max-width: 980px) {
    .detail-layout-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>
