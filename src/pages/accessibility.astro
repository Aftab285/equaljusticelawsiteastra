---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/global/Footer.astro';
import PageHero from '../components/global/PageHero.astro';
import StickyCTA from '../components/global/StickyCTA.astro';
import CaseAssistant from '../components/chat/CaseAssistant.astro';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Accessibility Statement' }
];
---

<Layout 
  title="Accessibility Statement | Equal Justice Lawyers"
  description="Equal Justice Lawyers is dedicated to digital accessibility for all Californians, in compliance with ADA Title III and WCAG 2.1 Level AA standards."
  canonical="https://equaljusticelawyers.com/accessibility/"
>
  <Navbar transparent={false} />

  <main id="main-content">
    <PageHero 
      kicker="ACCESSIBILITY & INCLUSION"
      title="Accessibility Statement"
      lead="Equal Justice Lawyers is committed to ensuring digital accessibility for individuals with disabilities across California. We continually improve the user experience for everyone."
      breadcrumb={breadcrumbs}
    />

    <section class="section-light legal-content-section">
      <div class="section-container">
        <div class="legal-card">
          <p class="effective-date"><strong>Commitment to Accessible Justice</strong> | WCAG 2.1 Level AA Standards</p>

          <h2>1. Our Commitment to Accessibility</h2>
          <p>
            Equal Justice Lawyers LLP believes that justice should be accessible to everyone, including individuals with visual, auditory, cognitive, and motor impairments. As advocates who regularly litigate California Unruh Civil Rights Act and Americans with Disabilities Act (ADA) matters, we hold ourselves to rigorous accessibility standards on our own website.
          </p>

          <h2>2. Conformance Standards</h2>
          <p>
            We strive to conform to the <strong>Web Content Accessibility Guidelines (WCAG) 2.1 Level AA</strong>. These guidelines explain how to make web content more accessible to people with a wide range of disabilities.
          </p>
          <p>Key accessibility features built into our website include:</p>
          <ul>
            <li><strong>High-Contrast Typography:</strong> Dark green, gold, and cream color schemes selected for optimal contrast ratios exceeding WCAG AA minimums.</li>
            <li><strong>Screen Reader Compatibility:</strong> Proper semantic HTML elements (`header`, `nav`, `main`, `footer`, `section`, `article`), ARIA roles, and skip-navigation links.</li>
            <li><strong>Keyboard Navigation:</strong> Complete keyboard accessibility for all navigation drawers, forms, buttons, and interactive modals without keyboard traps.</li>
            <li><strong>Descriptive Imagery:</strong> Informative text alternatives (`alt` tags) for all meaningful images and logos.</li>
            <li><strong>Responsive Scaling:</strong> Fluid typography and flexible layouts that gracefully support zoom levels up to 200% without loss of content or functionality.</li>
          </ul>

          <h2>3. Ongoing Auditing & Improvements</h2>
          <p>
            Web accessibility is an ongoing effort. We regularly test and audit our pages, intake forms, and case assistant widgets using automated tools and manual keyboard navigation reviews.
          </p>

          <h2>4. Feedback & Reasonable Accommodations</h2>
          <p>
            If you encounter any difficulty accessing content or need assistance completing our confidential intake forms, please reach out to us. We will provide the information, case evaluation, or services you need through an accessible alternative communication channel:
          </p>
          <div class="contact-box">
            <strong>Equal Justice Lawyers — Accessibility Coordinator</strong><br />
            Email: <a href="mailto:legal@equaljusticelawyers.com">legal@equaljusticelawyers.com</a><br />
            Confidential California Legal Intake
          </div>
        </div>
      </div>
    </section>
  </main>

  <StickyCTA />
  <CaseAssistant />
  <Footer />
</Layout>

<style>
  .legal-content-section {
    padding: 3.5rem 0 5rem;
  }

  .legal-card {
    max-width: 860px;
    margin: 0 auto;
    background: #ffffff;
    border: 1px solid rgba(200, 160, 74, 0.25);
    border-radius: 12px;
    padding: 3rem 3.5rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
  }

  .effective-date {
    font-size: 0.85rem;
    color: #64748b;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e2e8f0;
  }

  h2 {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    color: var(--color-dark-green-deep);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  p, li {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #334155;
    margin-bottom: 1rem;
  }

  ul {
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
  }

  li {
    margin-bottom: 0.5rem;
  }

  .contact-box {
    background: #fbf8f2;
    border-left: 4px solid var(--color-gold);
    padding: 1.25rem 1.5rem;
    border-radius: 6px;
    margin-top: 1.5rem;
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .contact-box a {
    color: var(--color-gold);
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .legal-card {
      padding: 2rem 1.5rem;
    }
  }
</style>
