---
interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const isSpanish = lang === 'es';
---

<div class="case-assistant-wrapper" id="case-assistant-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="assistant-title">
  <!-- Dim Backdrop -->
  <div class="assistant-backdrop" id="assistant-backdrop"></div>
  
  <!-- Assistant Panel -->
  <div class="assistant-panel" id="assistant-panel">
    <!-- Header -->
    <div class="assistant-header">
      <div class="assistant-avatar">
        <svg width="26" height="26" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="22" cy="22" r="20" stroke="#c8a04a" stroke-width="2.5" fill="none"/>
          <path d="M22 8 L22 14 M16 12 L22 14 L28 12 M14 14 L14 18 M30 14 L30 18 M12 18 L16 18 M28 18 L32 18" stroke="#c8a04a" stroke-width="2" stroke-linecap="round"/>
          <path d="M22 14 L22 28" stroke="#c8a04a" stroke-width="2.5" stroke-linecap="round"/>
          <path d="M16 28 L28 28 L26 34 L18 34 Z" fill="#c8a04a" opacity="0.4" stroke="#c8a04a" stroke-width="1.5"/>
        </svg>
      </div>
      <div class="assistant-title-box">
        <h3 id="assistant-title" class="assistant-name">
          {isSpanish ? 'Asistente de Casos Equal Justice' : 'Equal Justice Case Intake'}
        </h3>
        <span class="assistant-status">
          <span class="status-indicator"></span>
          {isSpanish ? 'En Línea • Evaluación Confidencial' : 'Online • Confidential Legal Review'}
        </span>
      </div>
      <button class="assistant-close-btn" id="assistant-close-btn" aria-label={isSpanish ? "Cerrar asistente" : "Close Assistant"}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Trust / Ethics Bar -->
    <div class="assistant-disclaimer-bar">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#c8a04a" stroke-width="2">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
      <span>
        {isSpanish 
          ? 'Admisión directa confidencial. Protegido bajo privilegio previo de consulta legal.' 
          : 'Confidential case intake. Free initial review across California.'}
      </span>
    </div>

    <!-- Scrollable Body Container -->
    <div class="assistant-body" id="assistant-body">
      <!-- FORM VIEW -->
      <div class="assistant-form-view" id="assistant-form-view">
        <div class="intake-greeting">
          <p class="greeting-lead">
            {isSpanish
              ? 'Conecte directamente con nuestro equipo legal de California. Complete estos detalles para iniciar su revisión confidencial:'
              : 'Connect directly with our California legal team. Provide your details below for immediate confidential review:'}
          </p>
        </div>

        <form id="assistant-lead-form" class="assistant-lead-form" novalidate>
          <!-- Category Pills -->
          <div class="form-field-group">
            <label class="field-label">
              {isSpanish ? '1. Tipo de Asunto Legal *' : '1. Legal Case Category *'}
            </label>
            <div class="category-pills" id="category-pills">
              <button type="button" class="category-pill is-active" data-val="Personal Injury">
                {isSpanish ? 'Lesiones / Accidente' : 'Personal Injury'}
              </button>
              <button type="button" class="category-pill" data-val="Employment Law">
                {isSpanish ? 'Trabajo / Despido' : 'Employment Law'}
              </button>
              <button type="button" class="category-pill" data-val="Medical Malpractice">
                {isSpanish ? 'Negligencia Médica' : 'Medical Malpractice'}
              </button>
              <button type="button" class="category-pill" data-val="Disability Rights">
                {isSpanish ? 'Discapacidad / ADA' : 'Disability Rights'}
              </button>
              <button type="button" class="category-pill" data-val="Consumer Protection">
                {isSpanish ? 'Protección Consumidor' : 'Consumer Rights'}
              </button>
              <button type="button" class="category-pill" data-val="Other Legal Dispute">
                {isSpanish ? 'Otro Asunto' : 'Other Matter'}
              </button>
            </div>
            <input type="hidden" id="chat-case-type" name="case_type" value="Personal Injury" />
          </div>

          <!-- Name Field -->
          <div class="form-field-group">
            <label for="chat-full-name" class="field-label">
              {isSpanish ? '2. Su Nombre Completo *' : '2. Your Full Name *'}
            </label>
            <input 
              type="text" 
              id="chat-full-name" 
              name="full_name" 
              class="field-input" 
              placeholder={isSpanish ? "Nombre y apellido..." : "First and last name..."} 
              required 
            />
          </div>

          <!-- Email & Phone Dual Row -->
          <div class="form-row-2">
            <div class="form-field-group">
              <label for="chat-email" class="field-label">
                {isSpanish ? '3. Correo Electrónico *' : '3. Email Address *'}
              </label>
              <input 
                type="email" 
                id="chat-email" 
                name="email" 
                class="field-input" 
                placeholder="name@example.com" 
                required 
              />
            </div>

            <div class="form-field-group">
              <label for="chat-phone" class="field-label">
                {isSpanish ? '4. Teléfono de Contacto *' : '4. Phone Number *'}
              </label>
              <input 
                type="tel" 
                id="chat-phone" 
                name="phone" 
                class="field-input" 
                placeholder="(555) 000-0000" 
                required 
              />
            </div>
          </div>

          <!-- California County / Location -->
          <div class="form-field-group">
            <label for="chat-county" class="field-label">
              {isSpanish ? '5. Condado o Ciudad en California' : '5. California County or City'}
            </label>
            <input 
              type="text" 
              id="chat-county" 
              name="county" 
              class="field-input" 
              placeholder={isSpanish ? "Ej: Los Ángeles, Orange County, San Diego, SF Bay Area..." : "e.g. Los Angeles, Orange County, San Diego, Bay Area..."} 
            />
          </div>

          <!-- Incident Summary Textarea -->
          <div class="form-field-group">
            <label for="chat-summary" class="field-label">
              {isSpanish ? '6. ¿Qué sucedió? (Breve resumen) *' : '6. What happened? (Brief summary) *'}
            </label>
            <textarea 
              id="chat-summary" 
              name="incident_summary" 
              class="field-textarea" 
              rows="3" 
              placeholder={isSpanish ? "Describa brevemente lo ocurrido, lesiones, fechas o detalles relevantes..." : "Briefly describe your incident, injuries, dispute, or employer actions..."}
              required
            ></textarea>
          </div>

          <!-- Alert / Error Notice if submission fails -->
          <div class="chat-form-alert" id="chat-form-alert" style="display: none;"></div>

          <!-- Submit Button -->
          <button type="submit" class="assistant-submit-btn" id="assistant-submit-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <span id="submit-btn-text">
              {isSpanish ? 'Enviar Evaluación de Caso' : 'Submit Confidential Case Evaluation'}
            </span>
          </button>

          <!-- Disclaimer Small -->
          <p class="form-fineprint">
            {isSpanish
              ? 'La información enviada es confidencial. No crea una relación abogado-cliente hasta que se firme un acuerdo formal por escrito.'
              : 'Submissions are confidential. An attorney-client relationship is only created once a formal written representation agreement is signed.'}
          </p>
        </form>
      </div>

      <!-- SUCCESS CONFIRMATION VIEW -->
      <div class="assistant-success-view" id="assistant-success-view" style="display: none;">
        <div class="success-icon-wrap">
          <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#c8a04a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
        </div>

        <h4 class="success-title">
          {isSpanish ? '¡Evaluación Recibida con Éxito!' : 'Case Evaluation Received!'}
        </h4>

        <p class="success-message">
          {isSpanish
            ? 'Gracias por comunicarse. Sus datos han sido transmitidos confidencialmente a nuestro equipo legal en California. Revisaremos su caso a la brevedad y nos comunicaremos con usted.'
            : 'Thank you for contacting Equal Justice Lawyers. Your intake details have been securely delivered directly to our California legal team. We will review your matter and reach out confidentially.'}
        </p>

        <div class="success-reassurance-box">
          <div class="reassurance-row">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#c8a04a" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            <span>{isSpanish ? 'Privilegio de Consulta Confidencial' : 'Strict Confidentiality Protected'}</span>
          </div>
          <div class="reassurance-row">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#c8a04a" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>{isSpanish ? 'Respuesta rápida de admisión' : 'Prompt intake team review'}</span>
          </div>
        </div>

        <button type="button" class="btn-gold success-close-btn" id="success-close-btn">
          {isSpanish ? 'Cerrar Ventana' : 'Done & Close'}
        </button>

        <button type="button" class="reset-form-link" id="reset-form-link">
          {isSpanish ? 'Enviar otra consulta legal' : 'Submit another inquiry'}
        </button>
      </div>
    </div>
  </div>

  <!-- Floating Launcher Trigger -->
  <button type="button" class="floating-chat-trigger" id="floating-chat-trigger" aria-label={isSpanish ? "Abrir Asistente de Casos" : "Open Confidential Legal Assistant"}>
    <div class="trigger-icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
      </svg>
      <span class="trigger-pulse"></span>
    </div>
    <span class="trigger-label">{isSpanish ? 'Chat Confidencial' : 'Chat / Case Intake'}</span>
  </button>
</div>

<script>
  // Case Assistant Intake Form Component
  const modal = document.getElementById('case-assistant-modal');
  const backdrop = document.getElementById('assistant-backdrop');
  const closeBtn = document.getElementById('assistant-close-btn');
  const floatingTrigger = document.getElementById('floating-chat-trigger');
  const leadForm = document.getElementById('assistant-lead-form') as HTMLFormElement;
  const formView = document.getElementById('assistant-form-view');
  const successView = document.getElementById('assistant-success-view');
  const successCloseBtn = document.getElementById('success-close-btn');
  const resetFormLink = document.getElementById('reset-form-link');
  const submitBtn = document.getElementById('assistant-submit-btn') as HTMLButtonElement;
  const submitBtnText = document.getElementById('submit-btn-text');
  const formAlert = document.getElementById('chat-form-alert');
  const caseTypeHidden = document.getElementById('chat-case-type') as HTMLInputElement;
  const categoryPills = document.querySelectorAll('.category-pill');

  const isEs = document.documentElement.lang === 'es';

  function openChat() {
    if (modal) {
      modal.classList.add('is-active');
      modal.setAttribute('aria-hidden', 'false');
      // Focus name field on open
      setTimeout(() => {
        const nameInput = document.getElementById('chat-full-name');
        nameInput?.focus();
      }, 150);
    }
  }

  function closeChat() {
    if (modal) {
      modal.classList.remove('is-active');
      modal.setAttribute('aria-hidden', 'true');
    }
  }

  // Expose globally for header/footer and any CTAs
  (window as any).openLegalChat = openChat;
  (window as any).closeLegalChat = closeChat;

  floatingTrigger?.addEventListener('click', openChat);
  closeBtn?.addEventListener('click', closeChat);
  backdrop?.addEventListener('click', closeChat);
  successCloseBtn?.addEventListener('click', closeChat);

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.classList.contains('is-active')) {
      closeChat();
    }
  });

  // Attach to all explicit chat links across the site
  const chatSelector = 'a[href="#chat"], [data-trigger-chat], #trigger-chat-btn, .chat-trigger-btn, .open-chat-btn';
  document.querySelectorAll(chatSelector).forEach(el => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      openChat();
    });
  });

  // Fallback text check for any button or link containing 'chat'
  document.querySelectorAll('a, button').forEach(el => {
    const href = el.getAttribute('href');
    const text = (el.textContent || '').trim().toLowerCase();
    if (href === '#chat' || text === 'chat' || text.includes('chat with us') || text.includes('chat en vivo') || text.includes('chat confidencial')) {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        openChat();
      });
    }
  });

  // Category pill selection
  categoryPills.forEach(pill => {
    pill.addEventListener('click', () => {
      categoryPills.forEach(p => p.classList.remove('is-active'));
      pill.classList.add('is-active');
      const val = pill.getAttribute('data-val') || 'Personal Injury';
      if (caseTypeHidden) {
        caseTypeHidden.value = val;
      }
    });
  });

  // Reset form link on success view
  resetFormLink?.addEventListener('click', () => {
    if (leadForm) leadForm.reset();
    if (formView) formView.style.display = 'block';
    if (successView) successView.style.display = 'none';
    if (submitBtn) {
      submitBtn.disabled = false;
      if (submitBtnText) {
        submitBtnText.textContent = isEs ? 'Enviar Evaluación de Caso' : 'Submit Confidential Case Evaluation';
      }
    }
  });

  // Handle Form Submission
  leadForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const nameInput = document.getElementById('chat-full-name') as HTMLInputElement;
    const emailInput = document.getElementById('chat-email') as HTMLInputElement;
    const phoneInput = document.getElementById('chat-phone') as HTMLInputElement;
    const countyInput = document.getElementById('chat-county') as HTMLInputElement;
    const summaryInput = document.getElementById('chat-summary') as HTMLTextAreaElement;

    // Reset error highlights
    [nameInput, emailInput, phoneInput, summaryInput].forEach(inp => inp?.classList.remove('has-error'));
    if (formAlert) {
      formAlert.style.display = 'none';
      formAlert.textContent = '';
    }

    const nameVal = nameInput?.value.trim();
    const emailVal = emailInput?.value.trim();
    const phoneVal = phoneInput?.value.trim();
    const countyVal = countyInput?.value.trim();
    const summaryVal = summaryInput?.value.trim();
    const caseTypeVal = caseTypeHidden?.value || 'Personal Injury';

    // Basic validation
    let hasError = false;
    if (!nameVal) {
      nameInput?.classList.add('has-error');
      hasError = true;
    }
    if (!emailVal || !emailVal.includes('@')) {
      emailInput?.classList.add('has-error');
      hasError = true;
    }
    if (!phoneVal || phoneVal.length < 7) {
      phoneInput?.classList.add('has-error');
      hasError = true;
    }
    if (!summaryVal) {
      summaryInput?.classList.add('has-error');
      hasError = true;
    }

    if (hasError) {
      if (formAlert) {
        formAlert.style.display = 'block';
        formAlert.textContent = isEs 
          ? 'Por favor complete todos los campos obligatorios (*) para que nuestro equipo pueda evaluar su caso.' 
          : 'Please complete all required fields (*) so our legal team can evaluate your case.';
      }
      return;
    }

    // Set submitting state
    if (submitBtn) {
      submitBtn.disabled = true;
      if (submitBtnText) {
        submitBtnText.textContent = isEs ? 'Transmitiendo confidencialmente...' : 'Sending to legal team...';
      }
    }

    const payload = {
      source: 'Equal Justice Case Assistant Form',
      full_name: nameVal,
      email: emailVal,
      phone: phoneVal,
      case_type: caseTypeVal,
      county: countyVal || 'California (Unspecified)',
      timeframe: 'Recent matter',
      has_attorney: 'No',
      incident_summary: summaryVal,
      preferred_language: isEs ? 'Español' : 'English'
    };

    try {
      // Primary transmission to /api/contact
      let response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      // Fallback transmission to /api/submit if needed
      if (!response.ok) {
        response = await fetch('/api/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
      }

      const resData = await response.json().catch(() => ({}));

      if (response.ok || (resData && resData.success !== false)) {
        // Success
        if (formView) formView.style.display = 'none';
        if (successView) successView.style.display = 'block';
        const bodyEl = document.getElementById('assistant-body');
        if (bodyEl) bodyEl.scrollTop = 0;
      } else {
        throw new Error(resData?.error || 'Submission failed');
      }
    } catch (err: any) {
      console.error('Case Assistant submission error:', err);
      if (formAlert) {
        formAlert.style.display = 'block';
        formAlert.textContent = isEs
          ? 'Hubo un error de conexión al enviar su consulta. Por favor intente de nuevo o escríbanos a legal@equaljusticelawyers.com'
          : 'A temporary connection error occurred. Please try again or email us directly at legal@equaljusticelawyers.com';
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        if (submitBtnText) {
          submitBtnText.textContent = isEs ? 'Reintentar Envío' : 'Retry Submission';
        }
      }
    }
  });
</script>

<style>
  /* Assistant Wrapper & Dim Backdrop */
  .case-assistant-wrapper {
    position: relative;
    z-index: 9999;
  }

  .assistant-backdrop {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(8, 18, 13, 0.65);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 9990;
  }

  .case-assistant-wrapper.is-active .assistant-backdrop {
    display: block;
  }

  /* Assistant Drawer / Modal Panel */
  .assistant-panel {
    position: fixed;
    bottom: 85px;
    right: 25px;
    width: 420px;
    max-width: calc(100vw - 32px);
    height: 620px;
    max-height: calc(100vh - 110px);
    background: #112119;
    border: 1.5px solid rgba(200, 160, 74, 0.4);
    border-radius: 12px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.55), 0 0 30px rgba(200, 160, 74, 0.1);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform: translateY(20px) scale(0.96);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.26s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.22s ease;
    z-index: 9995;
  }

  .case-assistant-wrapper.is-active .assistant-panel {
    transform: translateY(0) scale(1);
    opacity: 1;
    pointer-events: auto;
  }

  /* Header */
  .assistant-header {
    background: #172d22;
    padding: 0.95rem 1.15rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 1px solid rgba(200, 160, 74, 0.25);
    flex-shrink: 0;
  }

  .assistant-avatar {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .assistant-title-box {
    flex: 1;
    min-width: 0;
  }

  .assistant-name {
    font-family: var(--font-serif, "Cinzel", "Playfair Display", serif);
    font-size: 0.98rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.25;
    margin: 0;
    letter-spacing: 0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .assistant-status {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.74rem;
    color: var(--color-gold, #c8a04a);
    font-weight: 500;
    margin-top: 2px;
  }

  .status-indicator {
    width: 6px;
    height: 6px;
    background: #4ade80;
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 6px #4ade80;
  }

  .assistant-close-btn {
    background: transparent;
    border: none;
    color: #a8b3ac;
    padding: 6px;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s, background 0.2s;
  }

  .assistant-close-btn:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
  }

  /* Disclaimer / Trust Bar */
  .assistant-disclaimer-bar {
    background: rgba(200, 160, 74, 0.09);
    border-bottom: 1px solid rgba(200, 160, 74, 0.18);
    padding: 0.45rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    color: #dfd8cb;
    line-height: 1.35;
    flex-shrink: 0;
  }

  .assistant-disclaimer-bar svg {
    flex-shrink: 0;
  }

  /* Scrollable Body */
  .assistant-body {
    flex: 1;
    padding: 1.15rem;
    overflow-y: auto;
    background: radial-gradient(circle at top right, rgba(30, 60, 46, 0.4), transparent 75%), #112119;
  }

  .greeting-lead {
    font-size: 0.84rem;
    color: #dfd8cb;
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  /* Form Styling */
  .assistant-lead-form {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .form-field-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .field-label {
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--color-gold, #c8a04a);
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  /* Category selection pills */
  .category-pills {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.4rem;
  }

  .category-pill {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(200, 160, 74, 0.28);
    color: #dfd8cb;
    font-size: 0.76rem;
    font-weight: 500;
    padding: 0.48rem 0.55rem;
    border-radius: 6px;
    cursor: pointer;
    text-align: center;
    transition: all 0.2s ease;
  }

  .category-pill:hover {
    background: rgba(200, 160, 74, 0.15);
    color: #ffffff;
    border-color: var(--color-gold, #c8a04a);
  }

  .category-pill.is-active {
    background: var(--color-gold, #c8a04a);
    color: #0e1c14;
    font-weight: 700;
    border-color: var(--color-gold, #c8a04a);
    box-shadow: 0 2px 8px rgba(200, 160, 74, 0.35);
  }

  /* Inputs */
  .field-input,
  .field-textarea {
    width: 100%;
    background: rgba(9, 18, 13, 0.85);
    border: 1px solid rgba(200, 160, 74, 0.3);
    border-radius: 6px;
