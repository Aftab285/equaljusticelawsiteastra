---
interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const isSpanish = lang === 'es';

const practiceAreas = isSpanish
  ? [
      {
        id: 'personal-injury',
        title: 'Lesiones Personales y Accidentes Catastróficos',
        lead: 'Representación contundente para víctimas de negligencia grave en autopistas, propiedades comerciales y entornos de trabajo en California.',
        desc: 'El Código Civil de California establece que toda persona es responsable por los daños causados por falta de cuidado ordinario. Nuestros abogados luchan incansablemente para asegurar que las aseguradoras paguen la compensación médica, salarial y de dolor y sufrimiento que le corresponde.',
        sublinks: [
          { name: 'Accidentes de Auto', href: '/practice-areas/car-accidents/' },
          { name: 'Accidentes de Camión Comercial', href: '/practice-areas/truck-accidents/' },
          { name: 'Accidentes de Motocicleta', href: '/practice-areas/motorcycle-accidents/' },
          { name: 'Atropellos a Peatones', href: '/practice-areas/pedestrian-accidents/' },
          { name: 'Accidentes Uber / Lyft', href: '/practice-areas/rideshare-accidents/' },
          { name: 'Resbalones y Caídas', href: '/practice-areas/slip-and-fall/' },
          { name: 'Mordeduras de Perro', href: '/practice-areas/dog-bites/' },
          { name: 'Lesiones Cerebrales Traumáticas', href: '/practice-areas/brain-injuries/' },
          { name: 'Lesiones de la Médula Espinal', href: '/practice-areas/spinal-cord-injuries/' },
          { name: 'Homicidio Culposo', href: '/practice-areas/wrongful-death/' },
        ],
        badge: 'Negligencia & Daños'
      },
      {
        id: 'employment-law',
        title: 'Derecho Laboral y Derechos del Trabajador',
        lead: 'Protegemos a los trabajadores de California bajo la Ley de Empleo y Vivienda Justa (FEHA) y el Código Laboral de California.',
        desc: 'California tiene las protecciones laborales más sólidas del país. Si sufrió despido injustificado, discriminación, acoso sexual, represalias o robo de salarios (horas extras, descansos para comer no otorgados o mala clasificación como 1099), hacemos valer sus derechos.',
        sublinks: [
          { name: 'Despido Injustificado', href: '/practice-areas/wrongful-termination/' },
          { name: 'Discriminación Laboral', href: '/practice-areas/workplace-discrimination/' },
          { name: 'Acoso Sexual en el Trabajo', href: '/practice-areas/sexual-harassment/' },
          { name: 'Represalias Laborales', href: '/practice-areas/workplace-retaliation/' },
          { name: 'Salarios No Pagados y Horas Extras', href: '/practice-areas/wage-and-hour/' },
          { name: 'Represalias a Denunciantes (Whistleblower)', href: '/practice-areas/whistleblower-retaliation/' },
        ],
        badge: 'FEHA & Código Laboral'
      },
      {
        id: 'disability-rights',
        title: 'Derechos de Personas con Discapacidad',
        lead: 'Garantizamos el cumplimiento riguroso de la Ley de Derechos Civiles Unruh de California y el Título III de la ADA.',
        desc: 'Las empresas, arrendadores e instituciones públicas de California deben proporcionar adaptaciones razonables y eliminar barreras arquitectónicas y digitales. Abogamos por la plena inclusión y el respeto a la dignidad de cada individuo con discapacidad.',
        sublinks: [
          { name: 'Ley Unruh de California', href: '/practice-areas/disability-rights/' },
          { name: 'Adaptaciones Razonables Laborales', href: '/practice-areas/disability-rights/' },
          { name: 'Accesibilidad en Lugares Públicos', href: '/practice-areas/disability-rights/' },
        ],
        badge: 'Ley Unruh & ADA'
      },
      {
        id: 'medical-malpractice',
        title: 'Negligencia Médica y Hospitalaria',
        lead: 'Litigio complejo frente a hospitales, cirujanos y proveedores que violan el estándar médico de cuidado en California.',
        desc: 'Bajo las normas reformadas de California (AB 35 / MICRA), exigimos rendición de cuentas por errores en quirófanos, diagnósticos tardíos de cáncer, negligencia en partos y errores fatales de medicación con peritaje médico especializado.',
        sublinks: [
          { name: 'Errores Quirúrgicos', href: '/practice-areas/medical-malpractice/' },
          { name: 'Diagnóstico Erróneo o Tardío', href: '/practice-areas/medical-malpractice/' },
          { name: 'Lesiones de Nacimiento', href: '/practice-areas/medical-malpractice/' },
        ],
        badge: 'Litigio Complejo MICRA'
      },
      {
        id: 'consumer-protection',
        title: 'Protección al Consumidor y Prácticas Engañosas',
        lead: 'Defensa de los derechos del consumidor bajo la Sección 17200 del Código de Negocios y Profesiones de California (UCL).',
        desc: 'Protegemos al público frente a fraudes contractuales, tarifas ocultas no autorizadas, productos defectuosos y prácticas de cobranza abusivas que dañan financieramente a familias trabajadoras.',
        sublinks: [
          { name: 'Fraude Comercial y UCL § 17200', href: '/practice-areas/consumer-protection/' },
          { name: 'Cobranza Abusiva', href: '/practice-areas/consumer-protection/' },
          { name: 'Garantías Incumplidas', href: '/practice-areas/consumer-protection/' },
        ],
        badge: 'UCL § 17200'
      }
    ]
  : [
      {
        id: 'personal-injury',
        title: 'Personal Injury & Catastrophic Harm',
        lead: 'Aggressive trial advocacy for victims of life-altering injuries on California freeways, commercial properties, and job sites.',
        desc: 'Under California Civil Code § 1714, every person is responsible for injuries caused by a lack of ordinary care. Insurance companies work to minimize payouts—our attorneys investigate crash scenes, retain medical specialists, and fight for full financial compensation for medical bills, future care, lost earning capacity, and pain.',
        sublinks: [
          { name: 'Car Accidents', href: '/practice-areas/car-accidents/' },
          { name: 'Commercial Truck Accidents', href: '/practice-areas/truck-accidents/' },
          { name: 'Motorcycle Accidents', href: '/practice-areas/motorcycle-accidents/' },
          { name: 'Pedestrian Accidents', href: '/practice-areas/pedestrian-accidents/' },
          { name: 'Uber & Lyft Rideshare', href: '/practice-areas/rideshare-accidents/' },
          { name: 'Slip & Fall Premise Liability', href: '/practice-areas/slip-and-fall/' },
          { name: 'Dog Bites & Animal Attacks', href: '/practice-areas/dog-bites/' },
          { name: 'Traumatic Brain Injury (TBI)', href: '/practice-areas/brain-injuries/' },
          { name: 'Spinal Cord Injuries & Paralysis', href: '/practice-areas/spinal-cord-injuries/' },
          { name: 'Wrongful Death Claims', href: '/practice-areas/wrongful-death/' },
        ],
        badge: 'Negligence & Tort Law'
      },
      {
        id: 'employment-law',
        title: 'California Employment Law & Worker Rights',
        lead: 'Standing with California employees under the California Fair Employment & Housing Act (FEHA) and California Labor Code.',
        desc: 'California maintains the nation’s strongest worker protection statutes. If an employer illegally terminated you, retaliated against you for asserting protected rights, allowed hostile sexual harassment, or failed to pay correct overtime and mandatory meal breaks, our employment litigation team enforces the law.',
        sublinks: [
          { name: 'Wrongful Termination', href: '/practice-areas/wrongful-termination/' },
          { name: 'Workplace Discrimination', href: '/practice-areas/workplace-discrimination/' },
          { name: 'Sexual Harassment & Hostile Work Environment', href: '/practice-areas/sexual-harassment/' },
          { name: 'Workplace Retaliation', href: '/practice-areas/workplace-retaliation/' },
          { name: 'Wage & Hour / Overtime Violations', href: '/practice-areas/wage-and-hour/' },
          { name: 'Whistleblower Retaliation (Labor Code 1102.5)', href: '/practice-areas/whistleblower-retaliation/' },
        ],
        badge: 'FEHA & CA Labor Code'
      },
      {
        id: 'disability-rights',
        title: 'Disability Rights & Equal Accessibility',
        lead: 'Enforcing the California Unruh Civil Rights Act, Disabled Persons Act, and Title III of the Americans with Disabilities Act.',
        desc: 'California civil rights laws prohibit businesses, public agencies, and employers from discriminating against individuals with physical, mental, or sensory disabilities. We litigate failure-to-accommodate cases and architectural or digital barriers that deny equal access.',
        sublinks: [
          { name: 'California Unruh Civil Rights Act', href: '/practice-areas/disability-rights/' },
          { name: 'Workplace Reasonable Accommodations', href: '/practice-areas/disability-rights/' },
          { name: 'Public Accommodation Barrier Removal', href: '/practice-areas/disability-rights/' },
        ],
        badge: 'Unruh Civil Rights Act'
      },
      {
        id: 'medical-malpractice',
        title: 'Medical Negligence & Hospital Liability',
        lead: 'Handling high-stakes medical error litigation under California’s modernized MICRA framework (AB 35).',
        desc: 'When healthcare providers, surgeons, or hospitals fail to adhere to established California medical standards of care, the consequences can be catastrophic. We consult independent board-certified medical experts to analyze surgical errors, birth trauma, and missed cancer diagnoses.',
        sublinks: [
          { name: 'Surgical & Anesthesia Errors', href: '/practice-areas/medical-malpractice/' },
          { name: 'Delayed & Missed Diagnoses', href: '/practice-areas/medical-malpractice/' },
          { name: 'Labor & Birth Injury Claims', href: '/practice-areas/medical-malpractice/' },
        ],
        badge: 'California MICRA Standards'
      },
      {
        id: 'consumer-protection',
        title: 'Consumer Protection & Unfair Competition',
        lead: 'Holding dishonest companies accountable under California Business & Professions Code § 17200 (UCL).',
        desc: 'California’s Unfair Competition Law prohibits unlawful, unfair, or fraudulent business acts or practices, as well as deceptive advertising. We represent consumers harmed by predatory lending, unauthorized fees, bait-and-switch sales tactics, and defective products.',
        sublinks: [
          { name: 'Unfair Competition Law (UCL § 17200)', href: '/practice-areas/consumer-protection/' },
          { name: 'Deceptive Trade & False Advertising', href: '/practice-areas/consumer-protection/' },
          { name: 'Unlawful Consumer Debt Harassment', href: '/practice-areas/consumer-protection/' },
        ],
        badge: 'Cal. Bus. & Prof. § 17200'
      }
    ];
---

<section class="section-cream practice-areas-section" id="practice-areas">
  <div class="section-container">
    <div class="section-header-center">
      <span class="section-kicker">{isSpanish ? 'NUESTRAS ÁREAS DE PRÁCTICA' : 'OUR CORE PRACTICE AREAS'}</span>
      <h2 class="section-title">{isSpanish ? 'Defensa Legal Experta en Toda California' : 'Trusted Legal Support Across California'}</h2>
      <div class="gold-divider"></div>
      <p class="section-subtitle">
        {isSpanish
          ? 'Protegemos con firmeza a personas y familias en las áreas más críticas del derecho civil y laboral en California, con conocimiento legal profundo y compromiso inquebrantable.'
          : 'Our firm focuses exclusively on civil advocacy for individuals and families against insurance corporations and unlawful employers throughout the State of California.'}
      </p>
    </div>

    <div class="practice-areas-list">
      {practiceAreas.map((area, index) => (
        <article class="practice-area-row" id={area.id}>
          <div class="row-header-side">
            <span class="area-badge">{area.badge}</span>
            <h3 class="area-title">{area.title}</h3>
            <p class="area-lead">{area.lead}</p>
            <p class="area-desc">{area.desc}</p>
            <div class="area-cta-wrap">
              <a href={`/practice-areas/${area.id}/`} class="btn-dark">
                <span>{isSpanish ? 'Conocer Más Sobre Este Área' : 'Learn More About This Practice'}</span>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"></path>
                </svg>
              </a>
              <a href="#case-evaluation" class="link-eval">
                {isSpanish ? 'Solicitar Evaluación Gratuita →' : 'Request Free Evaluation →'}
              </a>
            </div>
          </div>

          <div class="row-sublinks-side">
            <h4 class="sublinks-heading">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#c8a04a" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
              </svg>
              <span>{isSpanish ? 'Asuntos y Reclamos Relacionados:' : 'Specific Matters & Related Claims:'}</span>
            </h4>
            <ul class="sublinks-grid">
              {area.sublinks.map((sub) => (
                <li>
                  <a href={sub.href} class="sublink-item">
                    <span class="sublink-bullet"></span>
                    <span class="sublink-name">{sub.name}</span>
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="sublink-arrow">
                      <path d="M5 12h14M12 5l7 7-7 7"></path>
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .practice-areas-section {
    border-bottom: 1px solid rgba(200, 160, 74, 0.2);
  }

  .practice-areas-list {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .practice-area-row {
    background: var(--color-white);
    border: 1px solid rgba(200, 160, 74, 0.22);
    border-radius: var(--radius-md);
    padding: 2.5rem;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem;
    box-shadow: var(--shadow-card);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .practice-area-row:hover {
    box-shadow: var(--shadow-card-hover);
    border-color: rgba(200, 160, 74, 0.4);
  }

  .row-header-side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .area-badge {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-gold-dark);
    background: rgba(200, 160, 74, 0.12);
    border: 1px solid rgba(200, 160, 74, 0.3);
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    margin-bottom: 1rem;
  }

  .area-title {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-dark-green);
    line-height: 1.25;
    margin-bottom: 0.8rem;
  }

  .area-lead {
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--color-dark-green-light);
    line-height: 1.55;
    margin-bottom: 0.75rem;
  }

  .area-desc {
    font-size: 0.88rem;
    line-height: 1.65;
    color: var(--color-text-dark-muted);
    margin-bottom: 1.8rem;
  }

  .area-cta-wrap {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-top: auto;
  }

  .link-eval {
    font-size: 0.86rem;
    font-weight: 700;
    color: var(--color-gold-dark);
    transition: color 0.2s;
  }

  .link-eval:hover {
    color: var(--color-dark-green);
  }

  /* Sublinks Side */
  .row-sublinks-side {
    background: var(--color-bg-light);
    border: 1px solid rgba(200, 160, 74, 0.18);
    border-radius: var(--radius-sm);
    padding: 1.8rem;
    display: flex;
    flex-direction: column;
  }

  .sublinks-heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-dark-green);
    margin-bottom: 1.2rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid rgba(200, 160, 74, 0.2);
  }

  .sublinks-grid {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .sublink-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.75rem;
    border-radius: var(--radius-sm);
    background: var(--color-white);
    border: 1px solid rgba(0, 0, 0, 0.04);
    transition: all 0.2s ease;
  }

  .sublink-bullet {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-gold);
    flex-shrink: 0;
  }

  .sublink-name {
    flex: 1;
    font-size: 0.84rem;
    font-weight: 500;
    color: var(--color-text-dark);
  }

  .sublink-arrow {
    color: var(--color-gold-dark);
    opacity: 0;
    transform: translateX(-4px);
    transition: all 0.2s ease;
  }

  .sublink-item:hover {
    background: rgba(200, 160, 74, 0.08);
    border-color: rgba(200, 160, 74, 0.35);
  }

  .sublink-item:hover .sublink-name {
    color: var(--color-dark-green);
    font-weight: 600;
  }

  .sublink-item:hover .sublink-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  @media (max-width: 980px) {
    .practice-area-row {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 1.8rem;
    }
  }
</style>
