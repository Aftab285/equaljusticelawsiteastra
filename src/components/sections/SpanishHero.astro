---
---

<section class="hero">
  <!-- Background Image with Overlay -->
  <div class="hero-bg">
    <img src="/images/hero-bg.jpg" alt="Estatua de la Dama de la Justicia con el horizonte de Los Ángeles" />
    <div class="hero-overlay"></div>
  </div>


  <!-- Hero Content -->
  <div class="hero-content">
    <div class="hero-text">
      <!-- Main Heading -->
      <h1 class="hero-heading">
        <span class="heading-gold">Abogados en California</span>
        <span class="heading-white">Luchando por Quienes</span>
        <span class="heading-white">Han Sido Agraviados</span>
      </h1>

      <!-- Description -->
      <p class="hero-description">
        Representamos a personas y familias en todo California en<br />
        <strong>lesiones personales</strong>, <strong>derecho laboral</strong>, <strong>derechos de discapacidad</strong>,<br />
        <strong>negligencia médica</strong> y <strong>protección al consumidor</strong>.<br />
        Usted enfóquese en sanar — nosotros nos enfocamos en la justicia.
      </p>

      <!-- CTA Buttons -->
      <div class="hero-buttons">
        <a href="#case-evaluation" class="btn btn-primary">
          <span>Evaluación Gratuita de Caso</span>
          <span class="btn-arrow">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </span>
        </a>
        <a href="tel:8005555878" class="btn btn-outline">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          <span>Llamar Ahora</span>
        </a>
        <a href="#chat" class="btn btn-outline chat-trigger-btn" id="hero-chat-btn-es" data-trigger-chat aria-label="Abrir Chat en Vivo">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
          <span>Chat en Vivo</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Trust Indicators Bar -->
  <div class="trust-bar">
    <div class="trust-bar-inner">
      <div class="trust-indicators">
        <!-- Confidential -->
        <div class="trust-item">
          <div class="trust-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#c8a04a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <polyline points="9 12 11 14 15 10"></polyline>
            </svg>
          </div>
          <div class="trust-text">
            <span class="trust-title">Confidencial</span>
            <span class="trust-desc">Su información siempre<br />permanece privada.</span>
          </div>
        </div>

        <!-- Divider -->
        <div class="trust-divider"></div>

        <!-- People-Focused -->
        <div class="trust-item">
          <div class="trust-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#c8a04a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <div class="trust-text">
            <span class="trust-title">Enfocados en Usted</span>
            <span class="trust-desc">Apoyo genuino.<br />Soluciones reales.</span>
          </div>
        </div>

        <!-- Divider -->
        <div class="trust-divider"></div>

        <!-- Serving All of California -->
        <div class="trust-item">
          <div class="trust-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#c8a04a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <div class="trust-text">
            <span class="trust-title">En Todo California</span>
            <span class="trust-desc">De Los Ángeles a San Diego<br />y el Valle Central.</span>
          </div>
        </div>
      </div>

      <!-- Script Text -->
      <div class="script-text">
        <span class="script-line-1">Justicia</span>
        <span class="script-line-2">para un Mañana</span>
        <span class="script-line-3">Más Brillante</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background:
      linear-gradient(
        to right,
        rgba(18, 32, 25, 0.92) 0%,
        rgba(18, 32, 25, 0.85) 25%,
        rgba(18, 32, 25, 0.65) 45%,
        rgba(18, 32, 25, 0.4) 60%,
        rgba(18, 32, 25, 0.15) 80%,
        rgba(18, 32, 25, 0.05) 100%
      ),
      linear-gradient(
        to bottom,
        rgba(18, 32, 25, 0.3) 0%,
        transparent 30%,
        transparent 70%,
        rgba(18, 32, 25, 0.4) 100%
      );
  }

  .hero-content {
    position: relative;
    z-index: 10;
    flex: 1;
    display: flex;
    align-items: flex-start;
    padding: 7rem 2rem 0;
    max-width: 1400px;
    width: 100%;
  }

  .hero-text {
    max-width: 600px;
    padding-top: 0.5rem;
  }

  .hero-heading {
    display: flex;
    flex-direction: column;
    margin-bottom: 1.2rem;
  }

  .heading-gold {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-weight: 400;
    font-style: italic;
    color: var(--color-gold);
    line-height: 1.25;
    letter-spacing: 0.01em;
    margin-bottom: 0.15rem;
  }

  .heading-white {
    font-family: var(--font-serif);
    font-size: 3rem;
    font-weight: 700;
    color: var(--color-white);
    line-height: 1.12;
    letter-spacing: -0.01em;
  }

  .hero-description {
    font-size: 0.9rem;
    line-height: 1.75;
    color: var(--color-text-light);
    margin-bottom: 1.8rem;
    font-weight: 300;
    letter-spacing: 0.01em;
  }

  .hero-description strong {
    color: var(--color-gold);
    font-weight: 600;
  }

  .hero-buttons {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.3rem;
    border-radius: 6px;
    font-size: 0.82rem;
    font-weight: 600;
    transition: all 0.25s ease;
    white-space: nowrap;
    letter-spacing: 0.01em;
  }

  .btn-primary {
    background: var(--color-gold);
    color: var(--color-dark-green);
    border-radius: 30px;
    padding: 0.75rem 1.5rem;
  }

  .btn-primary:hover {
    background: var(--color-gold-light);
    transform: translateY(-1px);
    box-shadow: 0 4px 15px rgba(200, 160, 74, 0.3);
  }

  .btn-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    background: rgba(26, 51, 40, 0.15);
    border-radius: 50%;
    margin-left: 0.2rem;
  }

  .btn-outline {
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-white);
    border: 1.5px solid rgba(255, 255, 255, 0.3);
    border-radius: 30px;
    backdrop-filter: blur(4px);
  }

  .btn-outline:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.5);
  }

  .trust-bar {
    position: relative;
    z-index: 10;
    margin-top: auto;
    padding: 0 2rem 1.8rem;
  }

  .trust-bar-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
  }

  .trust-indicators {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .trust-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(200, 160, 74, 0.08);
    border: 1px solid rgba(200, 160, 74, 0.18);
  }

  .trust-text {
    display: flex;
    flex-direction: column;
  }

  .trust-title {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-white);
    margin-bottom: 1px;
    letter-spacing: 0.01em;
  }

  .trust-desc {
    font-size: 0.68rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .trust-divider {
    width: 1px;
    height: 36px;
    background: rgba(255, 255, 255, 0.12);
  }

  .script-text {
    font-family: var(--font-script);
    color: var(--color-gold);
    display: flex;
    flex-direction: column;
    text-align: right;
    line-height: 1.1;
    padding-bottom: 0.3rem;
    opacity: 0.9;
  }

  .script-line-1 {
    font-size: 2.6rem;
  }

  .script-line-2 {
    font-size: 1.8rem;
    margin-top: -0.1rem;
  }

  .script-line-3 {
    font-size: 2.4rem;
    margin-top: -0.1rem;
  }

  @media (max-width: 1200px) {
    .script-text {
      display: none;
    }
  }

  @media (max-width: 1024px) {
    .heading-gold {
      font-size: 2rem;
    }
    .heading-white {
      font-size: 2.5rem;
    }
    .trust-divider {
      display: none;
    }
    .trust-indicators {
      flex-wrap: wrap;
      gap: 1rem;
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding-bottom: 2rem;
    }
    .hero-content {
      padding: 5.5rem 1rem 0;
    }
    .heading-gold {
      font-size: 1.6rem;
    }
    .heading-white {
      font-size: 2rem;
    }
    .hero-description {
      font-size: 0.85rem;
    }
    .hero-description br {
      display: none;
    }
    .hero-buttons {
      flex-direction: column;
      align-items: flex-start;
    }
    .trust-bar {
      padding: 1.5rem 1rem;
    }
    .trust-indicators {
      flex-direction: column;
      align-items: flex-start;
      width: 100%;
    }
  }
</style>
