---
interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const isSpanish = lang === 'es';

const categories = isSpanish
  ? [
      {
        id: 'personal-injury',
        title: 'Lesiones Personales',
        desc: 'Lesiones graves por negligencia de terceros o accidentes.',
        href: '/practice-areas/personal-injury/',
        icon: 'injury'
      },
      {
        id: 'car-accident',
        title: 'Accidente de Auto',
        desc: 'Colisiones vehiculares, choques de camiones, Uber/Lyft y peatones.',
        href: '/practice-areas/car-accidents/',
        icon: 'car'
      },
      {
        id: 'wrongful-termination',
        title: 'Despido Injustificado',
        desc: 'Despidos ilegales en represalia, por quejas o discriminación.',
        href: '/practice-areas/wrongful-termination/',
        icon: 'termination'
      },
      {
        id: 'workplace-discrimination',
        title: 'Discriminación Laboral',
        desc: 'Trato injusto por raza, edad, género, discapacidad o embarazo.',
        href: '/practice-areas/workplace-discrimination/',
        icon: 'discrimination'
      },
      {
        id: 'workplace-harassment',
        title: 'Acoso en el Trabajo',
        desc: 'Acoso sexual o ambiente laboral hostil protegido por FEHA.',
        href: '/practice-areas/sexual-harassment/',
        icon: 'harassment'
      },
      {
        id: 'unpaid-wages',
        title: 'Salarios No Pagados',
        desc: 'Horas extras no pagadas, descansos negados o mala clasificación.',
        href: '/practice-areas/wage-and-hour/',
        icon: 'wage'
      },
      {
        id: 'medical-malpractice',
        title: 'Negligencia Médica',
        desc: 'Errores quirúrgicos, diagnósticos erróneos y fallas hospitalarias.',
        href: '/practice-areas/medical-malpractice/',
        icon: 'medical'
      },
      {
        id: 'disability-rights',
        title: 'Derechos de Discapacidad',
        desc: 'Violaciones de la Ley ADA, Ley Unruh y denegación de adaptaciones.',
        href: '/practice-areas/disability-rights/',
        icon: 'disability'
      },
      {
        id: 'consumer-protection',
        title: 'Protección al Consumidor',
        desc: 'Fraudes comerciales, préstamos abusivos y prácticas engañosas.',
        href: '/practice-areas/consumer-protection/',
        icon: 'consumer'
      },
      {
        id: 'other-legal-problem',
        title: 'Otro Asunto Legal',
        desc: 'Consúltenos para evaluar si su situación legal tiene amparo en CA.',
        href: '#case-evaluation',
        icon: 'other'
      }
    ]
  : [
      {
        id: 'personal-injury',
        title: 'Personal Injury',
        desc: 'Severe harm or catastrophic injury caused by another party’s negligence.',
        href: '/practice-areas/personal-injury/',
        icon: 'injury'
      },
      {
        id: 'car-accident',
        title: 'Car & Vehicle Accident',
        desc: 'Traffic collisions, commercial trucks, rideshare accidents, and pedestrians.',
        href: '/practice-areas/car-accidents/',
        icon: 'car'
      },
      {
        id: 'wrongful-termination',
        title: 'Wrongful Termination',
        desc: 'Unlawful discharge in retaliation for whistleblowing, leave, or complaints.',
        href: '/practice-areas/wrongful-termination/',
        icon: 'termination'
      },
      {
        id: 'workplace-discrimination',
        title: 'Workplace Discrimination',
        desc: 'Adverse employment actions based on race, age, sex, disability, or identity.',
        href: '/practice-areas/workplace-discrimination/',
        icon: 'discrimination'
      },
      {
        id: 'workplace-harassment',
        title: 'Workplace Harassment',
        desc: 'Sexual harassment, retaliation, and unlawful hostile work environments.',
        href: '/practice-areas/sexual-harassment/',
        icon: 'harassment'
      },
      {
        id: 'unpaid-wages',
        title: 'Unpaid Wages & Overtime',
        desc: 'Denied meal breaks, off-the-clock work, and 1099 misclassification.',
        href: '/practice-areas/wage-and-hour/',
        icon: 'wage'
      },
      {
        id: 'medical-malpractice',
        title: 'Medical Malpractice',
        desc: 'Substandard patient care, surgical errors, and missed or delayed diagnoses.',
        href: '/practice-areas/medical-malpractice/',
        icon: 'medical'
      },
      {
        id: 'disability-rights',
        title: 'Disability Rights & ADA',
        desc: 'California Unruh Act and ADA accessibility and accommodation failures.',
        href: '/practice-areas/disability-rights/',
        icon: 'disability'
      },
      {
        id: 'consumer-protection',
        title: 'Consumer Protection',
        desc: 'Deceptive trade practices, fraudulent business conduct, and unlawful fees.',
        href: '/practice-areas/consumer-protection/',
        icon: 'consumer'
      },
      {
        id: 'other-legal-problem',
        title: 'Other Legal Problem',
        desc: 'Contact our intake team to review your specific California legal concern.',
        href: '#case-evaluation',
        icon: 'other'
      }
    ];
---

<section class="section-light case-selector-section" id="what-happened">
  <div class="section-container">
    <div class="section-header-center">
      <span class="section-kicker">{isSpanish ? 'SELECCIÓN DE CASO' : 'LEGAL PROBLEM SELECTOR'}</span>
      <h2 class="section-title">{isSpanish ? '¿Qué Sucedió?' : 'What Happened?'}</h2>
      <div class="gold-divider"></div>
      <p class="section-subtitle">
        {isSpanish
          ? 'Seleccione la situación legal que describe lo que ha vivido. Le orientaremos sobre sus derechos conforme a las leyes de California y cómo iniciar una evaluación confidencial.'
          : 'Select the legal issue that matches your situation. We will help you understand your rights under California law and the next steps for a free, confidential review.'}
      </p>
    </div>

    <!-- 10 Responsive Category Cards -->
    <div class="case-cards-grid">
      {categories.map((cat) => (
        <a href={cat.href} class="case-card" data-category={cat.id}>
          <div class="case-icon-wrap">
            {cat.icon === 'injury' && (
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#c8a04a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <path d="M12 8v8"></path>
                <path d="M8 12h8"></path>
              </svg>
            )}
            {cat.icon === 'car' && (
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#c8a04a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="5" width="20" height="14" rx="3"></rect>
                <path d="M5 19v2"></path>
                <path d="M19 19v2"></path>
                <circle cx="7" cy="14" r="2"></circle>
                <circle cx="17" cy="14" r="2"></circle>
              </svg>
            )}
            {cat.icon === 'termination' && (
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#c8a04a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                <line x1="9" y1="12" x2="15" y2="12"></line>
              </svg>
            )}
            {cat.icon === 'discrimination' && (
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#c8a04a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
                <path d="M2 12h20"></path>
              </svg>
            )}
            {cat.icon === 'harassment' && (
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#c8a04a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
            )}
            {cat.icon === 'wage' && (
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#c8a04a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="1" x2="12" y2="23"></line>
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
              </svg>
            )}
            {cat.icon === 'medical' && (
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#c8a04a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 2h-4a2 2 0 0 0-2 2v4a2 2 0 0 1-2 2H6a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h4a2 2 0 0 1 2 2v4a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-4a2 2 0 0 1 2-2h4a2 2 0 0 0 2-2v-4a2 2 0 0 0-2-2h-4a2 2 0 0 1-2-2V4a2 2 0 0 0-2-2z"></path>
              </svg>
            )}
            {cat.icon === 'disability' && (
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#c8a04a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="4" r="2"></circle>
                <path d="M16 8l-3 4-2-2-4 3"></path>
                <path d="M6 14a6 6 0 1 0 12 0"></path>
              </svg>
            )}
            {cat.icon === 'consumer' && (
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#c8a04a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="21" r="1"></circle>
                <circle cx="20" cy="21" r="1"></circle>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
              </svg>
            )}
            {cat.icon === 'other' && (
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#c8a04a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="16" x2="12" y2="12"></line>
                <line x1="12" y1="8" x2="12.01" y2="8"></line>
              </svg>
            )}
          </div>
          <div class="case-card-body">
            <h3 class="case-card-title">{cat.title}</h3>
            <p class="case-card-desc">{cat.desc}</p>
          </div>
          <div class="case-card-arrow" aria-hidden="true">
            <span>{isSpanish ? 'Ver Detalles' : 'Explore Options'}</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .case-selector-section {
    position: relative;
    border-bottom: 1px solid rgba(200, 160, 74, 0.15);
  }

  .case-cards-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.25rem;
  }

  .case-card {
    background: var(--color-white);
    border: 1px solid rgba(200, 160, 74, 0.22);
    border-radius: var(--radius-md);
    padding: 1.6rem 1.25rem 1.4rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: var(--shadow-card);
    position: relative;
  }

  .case-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-gold);
    box-shadow: var(--shadow-card-hover);
  }

  .case-icon-wrap {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-sm);
    background: rgba(200, 160, 74, 0.1);
    border: 1px solid rgba(200, 160, 74, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    transition: all 0.25s ease;
  }

  .case-card:hover .case-icon-wrap {
    background: var(--color-gold);
  }

  .case-card:hover .case-icon-wrap svg {
    stroke: var(--color-dark-green);
  }

  .case-card-body {
    flex: 1;
    margin-bottom: 1.2rem;
  }

  .case-card-title {
    font-family: var(--font-serif);
    font-size: 1.12rem;
    font-weight: 700;
    color: var(--color-dark-green);
    line-height: 1.25;
    margin-bottom: 0.45rem;
  }

  .case-card-desc {
    font-size: 0.8rem;
    color: var(--color-text-dark-muted);
    line-height: 1.5;
  }

  .case-card-arrow {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-gold-dark);
    margin-top: auto;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .case-card:hover .case-card-arrow {
    color: var(--color-dark-green);
    transform: translateX(3px);
  }

  @media (max-width: 1200px) {
    .case-cards-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 820px) {
    .case-cards-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }

  @media (max-width: 540px) {
    .case-cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
