---
interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const isSpanish = lang === 'es';
---

<section class="final-conversion-section" id="final-cta">
  <div class="final-cta-overlay"></div>

  <div class="section-container">
    <div class="final-cta-content">
      <span class="section-kicker kicker-gold">
        {isSpanish ? 'CONSULTA CONFIDENCIAL' : 'NO OBLIGATION • 100% CONFIDENTIAL'}
      </span>

      <h2 class="final-cta-title">
        {isSpanish ? 'Comience con una Conversación' : 'Start With a Conversation'}
      </h2>

      <div class="gold-divider"></div>

      <p class="final-cta-description">
        {isSpanish
          ? 'No tiene que enfrentar solo a las aseguradoras o corporaciones en California. Nuestro equipo legal está listo para escuchar su historia, evaluar sus derechos y orientarle con honestidad y respeto.'
          : 'You do not have to confront corporate insurance carriers or employers alone. Our California trial attorneys and intake specialists are prepared to review your facts, analyze your legal options, and stand firmly in your corner.'}
      </p>

      <!-- 3 CTA Buttons directly matching the approved Hero design -->
      <div class="final-cta-buttons">
        <a href="#case-evaluation" class="btn btn-primary">
          <span>{isSpanish ? 'Solicitar Evaluación Gratuita' : 'Get a Free Case Evaluation'}</span>
          <span class="btn-arrow">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </span>
        </a>

        <a href="tel:8005555878" class="btn btn-outline">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          <span>{isSpanish ? 'Llamar: (800) 555-JUSTICE' : 'Call Now'}</span>
        </a>

        <button type="button" class="btn btn-outline" id="final-chat-btn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
          <span>{isSpanish ? 'Chat en Vivo' : 'Chat With Us'}</span>
        </button>
      </div>

      <!-- Signature Script Accent -->
      <div class="final-signature">
        <span>Justice for a Brighter Tomorrow</span>
      </div>
    </div>
  </div>
</section>

<style>
  .final-conversion-section {
    position: relative;
    background: radial-gradient(circle at center, rgba(26, 51, 40, 0.95) 0%, var(--color-dark-green-deep) 80%);
    padding: 7rem 0 6.5rem;
    overflow: hidden;
    border-top: 1px solid rgba(200, 160, 74, 0.25);
  }

  .final-cta-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(18, 32, 25, 0.3) 0%, transparent 50%, rgba(18, 32, 25, 0.5) 100%);
    pointer-events: none;
  }

  .final-cta-content {
    position: relative;
    z-index: 2;
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .kicker-gold {
    color: var(--color-gold) !important;
  }

  .final-cta-title {
    font-family: var(--font-serif);
    font-size: 3rem;
    font-weight: 700;
    color: var(--color-white);
    line-height: 1.15;
    margin-bottom: 0.5rem;
  }

  .final-cta-description {
    font-size: 1.05rem;
    color: var(--color-text-light);
    line-height: 1.7;
    margin-bottom: 2.8rem;
    font-weight: 300;
  }

  .final-cta-buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 3.5rem;
  }

  /* Button styles mirroring Hero exactly */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.4rem;
    border-radius: var(--radius-pill);
    font-size: 0.86rem;
    font-weight: 600;
    transition: all 0.25s ease;
    white-space: nowrap;
  }

  .btn-primary {
    background: var(--color-gold);
    color: var(--color-dark-green);
    padding: 0.75rem 1.6rem;
  }

  .btn-primary:hover {
    background: var(--color-gold-light);
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(200, 160, 74, 0.35);
  }

  .btn-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    background: rgba(26, 51, 40, 0.15);
    border-radius: 50%;
    margin-left: 0.2rem;
  }

  .btn-outline {
    background: rgba(255, 255, 255, 0.08);
    color: var(--color-white);
    border: 1.5px solid rgba(255, 255, 255, 0.35);
    backdrop-filter: blur(4px);
  }

  .btn-outline:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.6);
    transform: translateY(-2px);
  }

  .final-signature {
    font-family: var(--font-script);
    font-size: 2.8rem;
    color: var(--color-gold);
    opacity: 0.9;
    letter-spacing: 0.02em;
  }

  @media (max-width: 768px) {
    .final-conversion-section {
      padding: 4.5rem 0;
    }
    .final-cta-title {
      font-size: 2.2rem;
    }
    .final-cta-buttons {
      flex-direction: column;
      width: 100%;
    }
    .final-cta-buttons .btn {
      width: 100%;
      justify-content: center;
    }
    .final-signature {
      font-size: 2.2rem;
    }
  }
</style>
