---
interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const isSpanish = lang === 'es';

const steps = isSpanish
  ? [
      {
        num: '01',
        title: 'Cuéntenos Qué Sucedió',
        desc: 'Comuníquese con nosotros por teléfono, chat o mediante nuestro formulario de admisión confidencial para compartir los detalles preliminares de su situación en California.'
      },
      {
        num: '02',
        title: 'Revisión Legal de Antecedentes',
        desc: 'Nuestro equipo legal analiza la viabilidad jurídica, los plazos de prescripción aplicables y las leyes de California pertinentes a su reclamo.'
      },
      {
        num: '03',
        title: 'Conversación Clara Sobre Sus Opciones',
        desc: 'Discutimos con usted de forma transparente los posibles caminos legales, los derechos que le asisten y qué esperar en cada etapa del proceso.'
      },
      {
        num: '04',
        title: 'Usted Decide el Próximo Paso',
        desc: 'Toma la decisión con total libertad y sin presiones. Si decidimos formalizar la representación mutua, se establece un acuerdo escrito claro y transparente.'
      }
    ]
  : [
      {
        num: '01',
        title: 'Tell Us What Happened',
        desc: 'Reach out by phone, through our secure intake chat, or via our online questionnaire to share the initial facts surrounding your injury or workplace dispute.'
      },
      {
        num: '02',
        title: 'We Review Your Information',
        desc: 'Our California legal intake attorneys review your facts, assess applicable California statutory deadlines, and examine whether a viable legal remedy exists.'
      },
      {
        num: '03',
        title: 'Discuss Your Legal Options',
        desc: 'We speak directly with you to explain your legal rights under California law in plain English or Spanish, detailing potential claims without confusing legalese.'
      },
      {
        num: '04',
        title: 'Decide on Your Next Step',
        desc: 'You decide whether and how to move forward with zero obligation. If we mutually agree to proceed, formal representation is confirmed via a written agreement.'
      }
    ];
---

<section class="section-cream process-section" id="how-it-works">
  <div class="section-container">
    <div class="section-header-center">
      <span class="section-kicker">{isSpanish ? 'PASO A PASO' : 'TRANSPARENT WORKFLOW'}</span>
      <h2 class="section-title">{isSpanish ? 'Cómo Funciona el Proceso' : 'How the Process Works'}</h2>
      <div class="gold-divider"></div>
      <p class="section-subtitle">
        {isSpanish
          ? 'Un camino claro, respetuoso y transparente desde el primer contacto hasta la resolución de sus dudas legales en California.'
          : 'A straightforward, dignified, and pressure-free process designed to provide clarity on your California legal standing from day one.'}
      </p>
    </div>

    <!-- Steps Grid -->
    <div class="process-grid">
      {steps.map((s, index) => (
        <div class="process-card">
          <div class="card-top-row">
            <span class="process-num">{s.num}</span>
            <div class="process-indicator-dot"></div>
          </div>
          <h3 class="process-title">{s.title}</h3>
          <p class="process-desc">{s.desc}</p>
        </div>
      ))}
    </div>

    <div class="process-footer-notice">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#c8a04a" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="16" x2="12" y2="12"></line>
        <line x1="12" y1="8" x2="12.01" y2="8"></line>
      </svg>
      <span>
        {isSpanish
          ? 'Aviso legal: La evaluación preliminar no garantiza que se acepte formalmente el caso ni predice un resultado específico.'
          : 'Legal Notice: Case evaluations are preliminary assessments and do not promise formal representation or specific outcomes.'}
      </span>
    </div>
  </div>
</section>

<style>
  .process-section {
    border-bottom: 1px solid rgba(200, 160, 74, 0.2);
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    position: relative;
  }

  .process-card {
    background: var(--color-white);
    border: 1px solid rgba(200, 160, 74, 0.25);
    border-radius: var(--radius-md);
    padding: 2.2rem 1.6rem;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-card);
    position: relative;
    transition: all 0.25s ease;
  }

  .process-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-gold);
    box-shadow: var(--shadow-card-hover);
  }

  .card-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .process-num {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-gold);
    line-height: 1;
  }

  .process-indicator-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(200, 160, 74, 0.25);
    border: 2px solid var(--color-gold);
  }

  .process-title {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-dark-green);
    line-height: 1.3;
    margin-bottom: 0.8rem;
  }

  .process-desc {
    font-size: 0.84rem;
    color: var(--color-text-dark-muted);
    line-height: 1.6;
  }

  .process-footer-notice {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 3rem;
    font-size: 0.78rem;
    color: var(--color-text-dark-muted);
    text-align: center;
  }

  @media (max-width: 1024px) {
    .process-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .process-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
